(footprint "TSAL6200_LayFlat_Inboard"
  (version 20240108)
  (generator "pcbnew")
  (layer "F.Cu")
  (descr "Vishay TSAL6200 5mm IR LED laid flat toward the card edge; transverse 2.54mm pad pair lets both leads share one 90-degree bend line")
  (tags "TSAL6200 IR LED 5mm horizontal lay flat inboard")
  (attr through_hole exclude_from_pos_files)
  (fp_text reference "REF**" (at 6.7 -3.7) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text value "TSAL6200_LAY_FLAT" (at 6.7 3.7) (layer "F.Fab")
    (effects (font (size 0.7 0.7) (thickness 0.1))))
  (fp_text user "IR -> EDGE" (at 3.7 0) (layer "F.Fab")
    (effects (font (size 0.52 0.52) (thickness 0.08))))
  (fp_text user "${REFERENCE}" (at 10.0 0) (layer "F.Fab")
    (effects (font (size 0.65 0.65) (thickness 0.1))))
  (fp_arc (start 1.85 -2.9) (mid 0.25 0) (end 1.85 2.9) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start 1.85 2.9) (end 9.55 2.9) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 9.55 2.9) (end 9.55 -2.9) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 9.55 -2.9) (end 1.85 -2.9) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_arc (start 1.85 -3.0) (mid 0.25 0) (end 1.85 3.0) (stroke (width 0.2) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_line (start 1.85 -3.0) (end 9.2 -3.0) (stroke (width 0.2) (type solid)) (layer "F.SilkS"))
  (fp_line (start 1.85 3.0) (end 9.2 3.0) (stroke (width 0.2) (type solid)) (layer "F.SilkS"))
  (fp_rect (start -0.1 -3.15) (end 13.55 3.15) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at 12.0 -1.27) (size 2.2 2.2) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 12.0 1.27) (size 2.2 2.2) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/PocketLab_Custom.3dshapes/TSAL6200_lay_flat_preview.wrl"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
