    (effects (font (size 0.48 0.48) (thickness 0.07))))
  (fp_text user "NONCONDUCTIVE ANCHOR - NO SOLDER" (at -13.0 -3.85) (layer "Cmts.User")
    (effects (font (size 0.48 0.48) (thickness 0.07))))
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
