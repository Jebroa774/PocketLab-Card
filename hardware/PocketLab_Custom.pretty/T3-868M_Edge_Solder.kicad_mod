(footprint "T3-868M_Edge_Solder"
  (version 20240108)
  (generator "pcbnew")
  (layer "F.Cu")
  (descr "DreamLNK T3-868M laid horizontally in an 18.8x6.58mm inboard edge pocket; one electrical feed pad plus a nonconductive adhesive anchor at the free end; never solder the free end")
