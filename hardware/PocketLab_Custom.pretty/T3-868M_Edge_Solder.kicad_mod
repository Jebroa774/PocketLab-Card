  (fp_line (start -19.3 -2.75) (end -2.0 -2.75) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -2.0 -2.75) (end -2.0 2.75) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -2.0 2.75) (end -19.3 2.75) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -19.3 2.75) (end -19.3 -2.75) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_circle (center -18.0 -2.85) (end -17.35 -2.85) (stroke (width 0.12) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -19.6 -3.05) (end 1.35 3.05) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" smd roundrect (at 0 0) (size 2.4 3.2) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
