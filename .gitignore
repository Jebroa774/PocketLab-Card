# PlatformIO build and editor state
firmware/.pio/
.vscode/
__pycache__/
*.py[cod]

# KiCad generated backups and caches
*-backups/
*.bak
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
hardware/*.rpt

# Reproducible PCB staging and autorouter artifacts
hardware/PocketLab-Card-netlisted.*
hardware/PocketLab-Card-planed.*
hardware/PocketLab-Card-routed.*
hardware/PocketLab-Card-routing-progress.*
hardware/PocketLab-Card-routing*.dsn
hardware/PocketLab-Card-routing*.ses
hardware/PocketLab-Card-placement-debug.kicad_pcb
hardware/reports/main-placement-drc.rpt
hardware/reports/netlisted-drc.rpt
hardware/reports/planed-drc.rpt
hardware/reports/routed-drc.rpt
hardware/reports/routing-progress-drc.rpt

# Local iterative routing/audit scratch files.  Deliberate pause/review
# snapshots belong in hardware/checkpoints instead.
hardware/.candidate-*
hardware/.tmp-*
hardware/.audit-*
hardware/.current-*

# Local iterative PCB routing candidates and DRC scratch output.  The accepted
# board lives at hardware/PocketLab-Card.kicad_pcb and its report is kept in
# hardware/reports/PocketLab-Card-drc.json.
hardware/.pre-*.kicad_pcb
hardware/PocketLab-Card-pre-*.kicad_pcb
hardware/PocketLab-Card-aux-*
hardware/PocketLab-Card-*.kicad_*
hardware/PocketLab-Card-*candidate*
hardware/PocketLab-Card-*trial*
hardware/PocketLab-Card-direct-*
hardware/PocketLab-Card-*scan*
hardware/trial-*
hardware/trial2-*
hardware/active-*
hardware/auto-*
hardware/batch-*
hardware/close-all-*
hardware/debug-*
hardware/full-reroute-*
hardware/manual-*
hardware/net-assignment-*
hardware/probe-*
hardware/special-*
hardware/special2-*
hardware/*-attempt.kicad_pcb
hardware/*-drc.json
hardware/bmi-region.txt
hardware/backups/
hardware/reports/*
!hardware/reports/PocketLab-Card-drc.json
hardware/~*.lck

# Manufacturing outputs are generated for tagged releases
manufacturing/*.zip
manufacturing/*.zip.sha256
manufacturing/build/
